#:import dp kivy.metrics.dp

<HomeScreen>

    MDBoxLayout:
        orientation: "vertical"
        spacing: dp(16)
        padding: dp(20)

        canvas.before:
            Color:
                rgba: 0.04, 0.05, 0.09, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # ---------- Header ----------

        MDBoxLayout:
            adaptive_height: True
            spacing: dp(12)

            MDIcon:
                icon: "robot-outline"
                theme_text_color: "Custom"
                text_color: 0,0.75,1,1
                font_size: "42sp"

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True

                MDLabel:
                    text: "AP AI"
                    bold: True
                    font_style: "H5"

                MDLabel:
                    text: "Jarvis Style Assistant"
                    theme_text_color: "Secondary"

        # ---------- Status Card ----------

        MDCard:
            orientation: "vertical"
            padding: dp(18)
            radius: [18]
            elevation: 3
            adaptive_height: True

            MDLabel:
                text: "System Status"
                bold: True

            MDLabel:
                text: "● Online"
                theme_text_color: "Custom"
                text_color: 0,0.8,1,1

            MDLabel:
                text: "Welcome back AP!"

        # ---------- Quick Actions ----------

        MDGridLayout:
            cols: 2
            spacing: dp(12)
            adaptive_height: True

            MDRaisedButton:
                text: "Chat"
                on_release: root.open_chat()

            MDRaisedButton:
                text: "Voice"
                on_release: root.open_voice()

            MDRaisedButton:
                text: "Memory"
                on_release: root.open_memory()

            MDRaisedButton:
                text: "Tools"
                on_release: root.open_tools()

            MDRaisedButton:
                text: "Settings"
                on_release: root.open_settings()

            MDRaisedButton:
                text: "Home"
                on_release: root.open_home()

        Widget

        # ---------- Bottom Bar ----------

        MDCard:
            adaptive_height: True
            padding: dp(10)
            radius: [25]

            MDBoxLayout:
                spacing: dp(10)

                MDIconButton:
                    icon: "home"
                    on_release: root.open_home()

                MDIconButton:
                    icon: "chat"
                    on_release: root.open_chat()

                MDIconButton:
                    icon: "microphone"
                    on_release: root.open_voice()

                MDIconButton:
                    icon: "brain"
                    on_release: root.open_memory()

                MDIconButton:
                    icon: "tools"
                    on_release: root.open_tools()

                MDIconButton:
                    icon: "cog"
                    on_release: root.open_settings()
