#:import dp kivy.metrics.dp

<HomeScreen>

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(16)

        MDTopAppBar:
            title: "AP AI"
            elevation: 0
            left_action_items: [["robot-outline", lambda x: None]]
            right_action_items: [["cog", lambda x: root.open_settings()]]

        MDCard:
            radius: [20]
            elevation: 3
            padding: dp(20)
            size_hint_y: None
            height: dp(190)

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(10)

                MDLabel:
                    text: "🤖 Welcome Back"
                    font_style: "H5"
                    bold: True

                MDLabel:
                    text: "AP AI Status : ONLINE"
                    theme_text_color: "Secondary"

                MDLabel:
                    text: "Version : V2.1"
                    theme_text_color: "Hint"

                Widget:

                MDRaisedButton:
                    text: "Open Chat"
                    size_hint: None, None
                    size: dp(150), dp(45)
                    pos_hint: {"center_x": .5}
                    on_release: root.open_chat()

        MDGridLayout:
            cols: 2
            spacing: dp(12)
            adaptive_height: True

            MDRaisedButton:
                text: "🎤 Voice"
                on_release: root.open_voice()

            MDRaisedButton:
                text: "🧠 Memory"
                on_release: root.open_memory()

            MDRaisedButton:
                text: "🛠 Tools"
                on_release: root.open_tools()

            MDRaisedButton:
                text: "⚙ Settings"
                on_release: root.open_settings()
