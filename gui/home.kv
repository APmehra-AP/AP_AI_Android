#:import dp kivy.metrics.dp

<HomeScreen>

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(15)

        canvas.before:
            Color:
                rgba: 0.04, 0.05, 0.09, 1
            Rectangle:
                pos: self.pos
                size: self.size

        MDLabel:
            text: "AP AI"
            halign: "center"
            font_style: "H4"
            theme_text_color: "Custom"
            text_color: 0, 0.75, 1, 1

        MDLabel:
            text: "Your Personal AI Assistant"
            halign: "center"
            theme_text_color: "Secondary"

        MDRaisedButton:
            text: "💬 Chat"
            pos_hint: {"center_x": .5}
            on_release: root.open_chat()

        MDRaisedButton:
            text: "🎤 Voice"
            pos_hint: {"center_x": .5}
            on_release: root.open_voice()

        MDRaisedButton:
            text: "🧠 Memory"
            pos_hint: {"center_x": .5}
            on_release: root.open_memory()

        MDRaisedButton:
            text: "🛠 Tools"
            pos_hint: {"center_x": .5}
            on_release: root.open_tools()

        MDRaisedButton:
            text: "⚙ Settings"
            pos_hint: {"center_x": .5}
            on_release: root.open_settings()

        Widget

        MDLabel:
            text: "AP AI Phase 1"
            halign: "center"
            theme_text_color: "Hint"
