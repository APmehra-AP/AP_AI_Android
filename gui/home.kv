#:import dp kivy.metrics.dp

<HomeScreen>

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(16)

        MDTopAppBar:
            title: "AP AI"
            elevation: 0
            left_action_items: [["robot-outline", lambda x: None]]
            right_action_items: [["cog-outline", lambda x: root.open_settings()]]

        MDCard:
            size_hint_y: None
            height: dp(220)
            radius: [24]
            elevation: 3
            padding: dp(20)

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(12)

                MDIcon:
                    icon: "robot-outline"
                    icon_size: "72sp"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.0, 0.75, 1.0, 1

                MDLabel:
                    text: "AP AI CORE"
                    halign: "center"
                    font_style: "H6"
                    bold: True

                MDLabel:
                    text: "Online • Ready to Assist"
                    halign: "center"
                    theme_text_color: "Secondary"

                Widget:

                MDRaisedButton:
                    text: "Open Chat"
                    size_hint: None, None
                    size: dp(160), dp(48)
                    pos_hint: {"center_x": .5}
                    on_release: root.open_chat()

        MDCard:
            size_hint_y: None
            height: dp(150)
            radius: [20]
            elevation: 2
            padding: dp(18)

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)

                MDLabel:
                    text: "Welcome Back"
                    font_style: "H5"
                    bold: True

                MDLabel:
                    text: "Your Personal AI Assistant"
                    theme_text_color: "Secondary"

                Widget:

                MDLabel:
                    text: "Status : ONLINE"
                    halign: "right"
                    theme_text_color: "Custom"
                    text_color: 0.0, 0.8, 0.4, 1

        MDLabel:
            text: "Quick Actions"
            bold: True
            adaptive_height: True

        MDGridLayout:
            cols: 2
            spacing: dp(12)
            adaptive_height: True

            MDCard:
                size_hint_y: None
                height: dp(120)
                radius: [18]
                elevation: 2

                MDBoxLayout:
                    orientation: "vertical"
                    padding: dp(12)
                    spacing: dp(8)

                    MDIcon:
                        icon: "message-text-outline"
                        halign: "center"
                        icon_size: "40sp"

                    MDLabel:
                        text: "Chat"
                        halign: "center"

                    MDRaisedButton:
                        text: "Open"
                        on_release: root.open_chat()

            MDCard:
                size_hint_y: None
                height: dp(120)
                radius: [18]
                elevation: 2

                MDBoxLayout:
                    orientation: "vertical"
                    padding: dp(12)
                    spacing: dp(8)

                    MDIcon:
                        icon: "microphone-outline"
                        halign: "center"
                        icon_size: "40sp"

                    MDLabel:
                        text: "Voice"
                        halign: "center"

                    MDRaisedButton:
                        text: "Open"
                        on_release: root.open_voice()

            MDCard:
                size_hint_y: None
                height: dp(120)
                radius: [18]
                elevation: 2

                MDBoxLayout:
                    orientation: "vertical"
                    padding: dp(12)
                    spacing: dp(8)

                    MDIcon:
                        icon: "brain"
                        halign: "center"
                        icon_size: "40sp"

                    MDLabel:
                        text: "Memory"
                        halign: "center"

                    MDRaisedButton:
                        text: "Open"
                        on_release: root.open_memory()

            MDCard:
                size_hint_y: None
                height: dp(120)
                radius: [18]
                elevation: 2

                MDBoxLayout:
                    orientation: "vertical"
                    padding: dp(12)
                    spacing: dp(8)

                    MDIcon:
                        icon: "tools"
                        halign: "center"
                        icon_size: "40sp"

                    MDLabel:
                        text: "Tools"
                        halign: "center"

                    MDRaisedButton:
                        text: "Open"
                        on_release: root.open_tools()

        MDLabel:
            text: "AI Status"
            bold: True
            adaptive_height: True

        MDCard:
            size_hint_y: None
            height: dp(130)
            radius: [20]
            elevation: 2
            padding: dp(16)

            MDBoxLayout:
                orientation: "horizontal"
                spacing: dp(16)

                MDIcon:
                    icon: "robot-outline"
                    icon_size: "56sp"
                    theme_text_color: "Custom"
                    text_color: 0.0, 0.75, 1.0, 1

                MDBoxLayout:
                    orientation: "vertical"

                    MDLabel:
                        text: "AP AI ONLINE"
                        bold: True

                    MDLabel:
                        text: "Ready for Commands"
                        theme_text_color: "Secondary"

                    MDLabel:
                        text: "Version : V3 Stable"
                        theme_text_color: "Hint"

        Widget:

        MDCard:
            size_hint_y: None
            height: dp(70)
            radius: [24]
            elevation: 3
            padding: dp(8)

            MDGridLayout:
                cols: 4
                spacing: dp(8)

                MDIconButton:
                    icon: "home"
                    on_release: root.open_home()

                MDIconButton:
                    icon: "message-text-outline"
                    on_release: root.open_chat()

                MDIconButton:
                    icon: "microphone-outline"
                    on_release: root.open_voice()

                MDIconButton:
                    icon: "cog-outline"
                    on_release: root.open_settings()
