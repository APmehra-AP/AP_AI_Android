#:import dp kivy.metrics.dp

<HomeScreen>

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(16)

        MDTopAppBar:
            title: "AP AI"
            left_action_items: [["robot-outline", lambda x: None]]
            right_action_items: [["cog", lambda x: root.open_settings()]]

        MDCard:
            radius: [20]
            padding: dp(20)
            size_hint_y: None
            height: dp(150)
            elevation: 3

            MDBoxLayout:
                orientation: "vertical"

                MDLabel:
                    text: "Welcome Back"
                    font_style: "H5"
                    bold: True

                MDLabel:
                    text: "AP AI is Online"
                    theme_text_color: "Secondary"

                Widget

                MDRaisedButton:
                    text: "Open Chat"
                    size_hint: None, None
                    size: dp(140), dp(45)
                    on_release: root.open_chat()
