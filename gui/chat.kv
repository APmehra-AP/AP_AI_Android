#:import dp kivy.metrics.dp

<ChatScreen>

    MDBoxLayout:
        orientation: "vertical"
        spacing: dp(10)
        padding: dp(10)

        MDTopAppBar:
            title: "AP AI Chat"
            left_action_items: [["arrow-left", lambda x: root.go_home()]]

        MDCard:
            elevation: 2
            radius: [15]
            padding: dp(15)
            size_hint_y: 1

            ScrollView:

                MDLabel:
                    id: chat_label
                    text: "🤖 AP AI\n\nWelcome!\n"
                    adaptive_height: True
                    halign: "left"
                    text_size: self.width, None

        MDBoxLayout:
            size_hint_y: None
            height: dp(60)
            spacing: dp(8)

            MDTextField:
                id: message_input
                hint_text: "Type a message..."

            MDRaisedButton:
                text: "Send"
                on_release: root.send_message()
