#:import dp kivy.metrics.dp

<ChatScreen>

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        MDTopAppBar:
            title: "AP AI Chat"
            elevation: 0
            left_action_items: [["arrow-left", lambda x: app.root.current = "home"]]

        ScrollView:

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                spacing: dp(12)
                padding: dp(8)

                MDCard:
                    size_hint_x: .85
                    adaptive_height: True
                    radius: [18]
                    elevation: 2
                    padding: dp(14)
                    pos_hint: {"x": 0}

                    MDLabel:
                        text: "👋 Hello! I am AP AI. How can I help you today?"
                        adaptive_height: True
                        theme_text_color: "Primary"

                MDCard:
                    size_hint_x: .85
                    adaptive_height: True
                    radius: [18]
                    elevation: 2
                    padding: dp(14)
                    pos_hint: {"right": 1}

                    MDLabel:
                        text: "Hi AP!"
                        adaptive_height: True
                        halign: "right"

        MDCard:
            size_hint_y: None
            height: dp(70)
            radius: [20]
            elevation: 2
            padding: dp(8)

            MDBoxLayout:
                spacing: dp(8)

                MDTextField:
                    id: message_input
                    hint_text: "Type a message..."
                    mode: "rectangle"

                MDIconButton:
                    icon: "microphone-outline"

                MDRaisedButton:
                    text: "Send"
